FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install uv for fast, reproducible installs.
RUN pip install --no-cache-dir uv==0.4.20

# Copy workspace metadata first for better layer caching.
COPY pyproject.toml /app/pyproject.toml
COPY core/pyproject.toml /app/core/pyproject.toml
COPY api/pyproject.toml /app/api/pyproject.toml
COPY sdk/pyproject.toml /app/sdk/pyproject.toml

# Create minimal src skeletons so uv can resolve the workspace layout.
RUN mkdir -p /app/core/src/portolan_core /app/api/src/portolan_api /app/sdk/src/portolan_sdk \
    && touch /app/core/src/portolan_core/__init__.py \
             /app/api/src/portolan_api/__init__.py \
             /app/sdk/src/portolan_sdk/__init__.py

RUN uv sync --all-packages --no-dev

# Now copy the actual sources (layer changes most often).
COPY core/src /app/core/src
COPY api/src /app/api/src
COPY sdk/src /app/sdk/src

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "portolan_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
