# Portolan Hub — example environment variables.
# Copy to `.env` and adjust. Never commit `.env`.

# ===========================================================================
# API
# ===========================================================================

# Log verbosity: DEBUG | INFO | WARNING | ERROR
PORTOLAN_LOG_LEVEL=INFO

# Host/port the API binds to. In docker-compose, keep 0.0.0.0.
PORTOLAN_API_HOST=0.0.0.0
PORTOLAN_API_PORT=8000

# Comma-separated CORS origins allowed to hit the API.
PORTOLAN_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Static bearer token for MVP auth. Replace with a strong random value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTOLAN_API_TOKEN=dev-token-change-me

# Contact address surfaced to institutions via the User-Agent header.
# Required so institutions can reach you if your traffic becomes a concern.
PORTOLAN_CONTACT_EMAIL=contact@example.org

# ===========================================================================
# Cache (Sprint 3)
# ===========================================================================

# Redis connection URL. Falls back to in-memory cache if unset.
# PORTOLAN_REDIS_URL=redis://localhost:6379/0

# ===========================================================================
# Plugins (Sprint 1+)
# ===========================================================================

# Extra path scanned for local plugin manifests, in addition to entry points.
# PORTOLAN_PLUGINS_DIR=./plugins

# ===========================================================================
# Console (Vite / SvelteKit)
# ===========================================================================

# Base URL the console uses to reach the API from the browser.
PUBLIC_API_BASE_URL=http://localhost:8000
